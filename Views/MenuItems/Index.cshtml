@model IEnumerable<Anthemis.Models.MenuItem>

@{
    ViewData["Title"] = "Manage Menu Items";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-1">Menu Items</h2>

        <a asp-controller="MenuItems" asp-action="Create" class="btn btn-success">Add New Item</a>
    </div>

    @if (!Model.Any()){
        <div class="alert alert-info">
            No menu items found.
        </div>
    } else {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Description</th>
                    <th>Image URL</th>
                    <th class="text-nowrap">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model){
                    <tr>
                        <td>@item.Name</td>
                        <td><span class="badge bg-secondary">@item.Category</span></td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Description</td>
                        <td>
                            @if (string.IsNullOrEmpty(item.ImageUrl)){
                                <span class="text-muted">No image</span>
                            } else {
                                <span class="small text-muted">@item.ImageUrl</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-controller="MenuItems" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-controller="MenuItems" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    }
</div>