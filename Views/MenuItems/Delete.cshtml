@model Anthemis.Models.MenuItem

@{
    ViewData["Title"] = "Delete Menu Item";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-danger">
                <div class="card-body">
                    <h2 class="text-center text-danger mb-4">Delete Menu Item</h2>

                    <div class="alert alert-warning">
                        Are you sure you want to delete this menu item?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    </dl>

                    <form asp-controller="MenuItems" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id">

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Delete</button>

                            <a asp-controller="MenuItems" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>