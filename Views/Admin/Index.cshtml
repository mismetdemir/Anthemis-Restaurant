@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Admin Panel</h1>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4 class="card-title">Menu Management</h4>
                    <p class="card-text text-muted">
                        Add, edit, delete and list restaurant menu items.
                    </p>

                    <a asp-controller="MenuItems" asp-action="Index" class="btn btn-primary">Manage Menu Items</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4 class="card-title">Reservations</h4>
                    <p class="card-text text-muted">
                        View all customer reservations.
                    </p>

                    <a asp-controller="Admin" asp-action="Reservations" class="btn btn-success">View Reservations</a>
                </div>
            </div>
        </div>
    </div>
</div>