@model IEnumerable<Anthemis.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-4">
    <h2 class="mb-4">Reservations</h2>

    @if (TempData["SuccessMessage"] != null){
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any()){
        <div class="alert alert-info">
            There are no reservations yet.
        </div>
    } else {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>User Id</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Guests</th>
                    <th>Status</th>
                    <th>Note</th>
                    <th class="text-nowrap">Update Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model){
                    var badgeClass = item.Status switch {
                        "Approved" => "bg-success",
                        "Cancelled" => "bg-danger",
                        "Pending" => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>@item.UserId</td>
                        <td>@item.FullName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.ReservationDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ReservationTime.ToString(@"hh\:mm")</td>
                        <td>@item.GuestCount</td>
                        <td>
                            <span class="badge @badgeClass">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(item.Note)){
                                <span class="text-muted">No note</span>
                            } else {
                                @item.Note
                            }
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="UpdateReservationStatus" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@item.Id" />
                                <select name="status" class="form-select form-select-sm">
                                    @if (item.Status == "Pending"){
                                        <option value="Pending" selected>Pending</option>
                                    } else {
                                        <option value="Pending">Pending</option>
                                    }

                                    @if (item.Status == "Approved"){
                                        <option value="Approved" selected>Approved</option>
                                    } else {
                                        <option value="Approved">Approved</option>
                                    }

                                    @if (item.Status == "Cancelled") {
                                        <option value="Cancelled" selected>Cancelled</option>
                                    } else {
                                        <option value="Cancelled">Cancelled</option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    }
</div>